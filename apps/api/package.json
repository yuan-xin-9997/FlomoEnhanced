{
  "name": "@flomo/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "浮墨增强版后端（Fastify 5 + node:sqlite）",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "predev": "npm run build -w @flomo/shared",
    "test": "node --no-warnings=ExperimentalWarning --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/static": "^8.0.0",
    "@flomo/shared": "*",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0"
  }
}
